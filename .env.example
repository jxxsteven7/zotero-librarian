# Copy to .env (then `chmod 600 .env` on Linux/macOS). .env is git-ignored — never commit it. One per machine.
ZOTERO_API_KEY=create at https://www.zotero.org/settings/keys/new with Allow library access + Allow write access, paste it here
ZOTERO_LIBRARY_ID=your numeric user id (shown on https://www.zotero.org/settings/keys; leave empty and zl.py setup prints it)
# Zotero data directory. Leave unset to read it from Zotero's prefs.js (extensions.zotero.dataDir); the platform default
# (~/Zotero, C:\Users\you\Zotero) is the last resort. Zotero > Settings > Advanced > Files and Folders shows it.
# On Windows write the path as-is, e.g. C:\Users\you\Zotero.
#ZOTERO_DATA_DIR=~/Zotero
# pdftotext outside PATH (Windows example: C:\Program Files\poppler-24.08.0\Library\bin\pdftotext.exe)
#PDFTOTEXT=
# Who adjudicates the borderline tags (see README "Who adjudicates"). ollama = a local model through Ollama (free, needs
# ~6 GB of RAM/VRAM for the default model); openai = any OpenAI-compatible server (LM Studio, vLLM, llama.cpp, or a hosted
# API with ZC_LLM_KEY); agent = no local model, the coding agent that runs the command answers (costs tokens; for
# machines without a GPU / spare RAM); off = rules only, borderline tags are just listed.
ZC_LLM=ollama
ZC_LLM_MODEL=qwen3.5:9b
ZC_LLM_URL=http://127.0.0.1:11434
#ZC_LLM_KEY=
#ZC_LLM_TIMEOUT=180
# Semantic Scholar API key (optional; raises the rate limit for `zl.py refs`)
#S2_API_KEY=
